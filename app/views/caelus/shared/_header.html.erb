<div class="flex justify-end items-center m-0 gap-4">
  <%= render "caelus/shared/location_selector" %>
  <%= render "caelus/shared/dark_mode_toggle" %>
</div>

<h1 class="text-3xl font-bold">
  <%= link_to(
    caelus_root_path,
    class: "text-cosmic hover:text-accent transition-all duration-150 ease-in-out"
  ) do %>
    ✨ <%= content_for?(:title) ? yield(:title) : t("caelus.title") %>
  <% end %>
</h1>

<p class="text-muted-foreground">
  <%= l(
    Time.current.localtime(@observer.utc_offset).to_date,
    format: :long
  ) %>
  UTC<%= @observer.utc_offset %>
  [<%= format_observer_coordinates(@observer) %>]
</p>
