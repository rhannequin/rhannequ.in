    .about-page .content-link {
      color: #1e3a8a;
      text-decoration: underline;
      font-weight: 500;
      transition-property: color;
      transition-duration: 200ms;
    }

    .about-page .content-link:hover {
      text-decoration: none;
      color: #1d4ed8;
    }

    .about-page .content-link:visited {
      color: #1e40af;
    }

    .about-page .simple-link {
      color: #1e3a8a;
      text-decoration: underline;
      transition-property: color;
      transition-duration: 200ms;
    }

    .about-page .simple-link:hover {
      text-decoration: none;
      color: #1d4ed8;
    }

    .about-page .simple-link:visited {
      color: #1e40af;
    }

    .about-page .footer-link {
      color: #6b7280;
      text-decoration: none;
      font-weight: 400;
      transition: color 0.2s ease;
    }

    .about-page .footer-link:visited {
      color: #6b7280;
    }

    .about-page .footer-link:hover,
    .about-page .footer-link:visited:hover {
      color: #1f2937;
    }
  </style>
<% end %>

<div class="max-w-4xl mx-auto about-page">
  <header class="mb-12">
    <h1 class="text-5xl font-bold mb-6 text-gray-900 leading-tight">
      Hi, I'm Rémy.
    </h1>

    <div class="prose prose-lg prose-blue max-w-none space-y-6">
      <p class="text-xl text-gray-700 leading-relaxed">
        I am a senior developer working at
        <a href="https://thoughtbot.com/" class="content-link">
          thoughtbot</a>.
      </p>

      <p class="text-xl text-gray-700 leading-relaxed">
        I work on some open source and I am the creator and maintainer of
        <a href="https://github.com/rhannequin/astronoby" class="content-link">
          Astronoby</a>, a Ruby
        library to compute astronomical data and events.
      </p>

      <p class="text-xl text-gray-700 leading-relaxed">
        I also maintain other open-source tools like
        <a href="https://caelus.rhannequ.in" class="content-link">
          Caelus</a>,
        an astronomical dashboard built with Astronoby and Ruby on Rails.
      </p>
    </div>
  </header>

